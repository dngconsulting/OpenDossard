# Application
NODE_ENV=development
PORT=3001

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dossarduser
POSTGRES_PASSWORD=dossardpassword
POSTGRES_DB=dossarddb

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRE=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Origine publique du backoffice (sans path, query ni hash) : sert à construire les
# liens envoyés par email (ex. réinitialisation de mot de passe → /reset-password#token=...).
# Obligatoire, http(s) (https en production). Absente ou invalide : l'API démarre quand même,
# mais la demande de lien de réinitialisation est désactivée (erreur dans les logs).
WEBAPP_PUBLIC_URL=http://localhost:5173

# HelloAsso OAuth (sandbox par défaut — basculer en prod = retirer "-sandbox")
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_OAUTH_BASE_URL=https://auth.helloasso-sandbox.com
HELLOASSO_API_BASE_URL=https://api.helloasso-sandbox.com
HELLOASSO_REDIRECT_URI=http://localhost:3001/api/v2/helloasso/oauth/callback
# Origine de la SPA vers laquelle le backend redirige (302) après le callback HelloAsso.
# Le path est ajouté par le backend : /club/{clubId}?status=success&slug=Y en succès,
# /clubs?status=error&reason=... en erreur. Pas de path à mettre ici, juste l'origine.
HELLOASSO_FRONT_RESULT_URL=http://localhost:5173
# Clé AES-256-GCM (32 octets base64) pour chiffrer les tokens HelloAsso en DB.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HELLOASSO_TOKEN_ENCRYPTION_KEY=
# Optionnel — TTL du cache de state OAuth (défaut 600s = 10 min)
# HELLOASSO_STATE_TTL_SECONDS=600
# URLs vers lesquelles HelloAsso redirige le navigateur APRÈS le paiement.
# Doivent être des deep links Dossardeur en prod ; en dev sandbox, des URLs web
# de fallback sont acceptables (HelloAsso impose HTTPS sauf pour les schemes custom).
# Arme le job quotidien (03:00) de renouvellement des tokens HelloAsso des clubs.
# DÉSARMÉ par défaut : ne l'activer QUE sur l'environnement détenant les liaisons
# faisant autorité. PREPROD partage les clés HelloAsso de la PROD, et HelloAsso
# révoque un refresh token émis dès qu'un ancien est réutilisé — deux
# environnements armés se détruiraient mutuellement leurs liaisons.
# Seule la valeur exacte "true" arme le job.
HELLOASSO_TOKEN_REFRESH_ENABLED=false

HELLOASSO_PAYMENT_RETURN_URL_SUCCESS=dossardeur://payment/success
HELLOASSO_PAYMENT_RETURN_URL_ERROR=dossardeur://payment/error
HELLOASSO_PAYMENT_RETURN_URL_CANCELLED=dossardeur://payment/cancelled
# Clés de signature webhook : AUCUNE variable d'env. Elles sont récupérées en
# direct depuis HelloAsso (GET /v5/partners/me → urlNotificationList) et mises
# en cache mémoire au boot par HelloAssoWebhookKeysService (refresh-on-miss à la
# réception d'un webhook). Source de vérité = HelloAsso, pas de secret à gérer.

# Emails transactionnels (API HTTP Brevo)
# MAIL_MODE pilote l'envoi :
#   send     → envoi réel (PROD, PREPROD)
#   redirect → envoi réel, mais TOUS les mails partent vers MAIL_REDIRECT_TO (TEST),
#              sujet préfixé par le destinataire initial — jamais d'écriture à un vrai utilisateur
#   log      → aucun envoi, le mail est seulement logué (local, e2e). Défaut si absent ou vide,
#              sauf avec NODE_ENV=production où MAIL_MODE est obligatoire.
# En send/redirect, BREVO_API_KEY et MAIL_FROM sont obligatoires (et MAIL_REDIRECT_TO en redirect).
# Config invalide : l'API démarre quand même, l'envoi d'emails est désactivé (erreur dans les logs
# au boot, puis à chaque email non envoyé).
MAIL_MODE=log
# Expéditeur : doit être une adresse validée côté Brevo
MAIL_FROM=
# Optionnel — nom d'expéditeur affiché
MAIL_FROM_NAME=Open Dossard
# Obligatoire en mode redirect uniquement
MAIL_REDIRECT_TO=
BREVO_API_KEY=
